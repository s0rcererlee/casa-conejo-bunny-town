k": [-47, -15, 1.7], "description": "格拉纳达｜赭红城墙、细柱拱廊与长方形倒影水庭，提炼阿尔罕布拉宫的空间意象。"}, {"name": "安达卢西亚 · 塞维利亚吉拉尔达塔", "position": [1, -42], "camera": [16, -60, 19], "look": [1, -42, 8], "description": "塞维利亚｜修长砖石塔身、成对拱窗、开放钟楼和顶部风向标。宗教建筑风格化致敬。"}, {"name": "巴斯克 · 毕尔巴鄂古根海姆博物馆", "position": [23, -41], "camera": [43, -60, 17], "look": [23, -41, 3.5], "description": "毕尔巴鄂｜弗兰克·盖里的钛金属曲面语言：扭转体块、玻璃中庭与水岸广场。风格化致敬。"}, {"name": "美食街 · 蛋糕店", "position": [-25, -61], "camera": [-15, -79, 11], "look": [-25, -61, 1.3], "description": "蛋糕店：彩色遮阳篷、食品展示柜和露天座位。兔子可以从正门走入，寻找自己的胡萝卜。"}, {"name": "美食街 · 冰淇淋店", "position": [-15, -61], "camera": [-5, -79, 11], "look": [-15, -61, 1.3], "description": "冰淇淋店：彩色遮阳篷、食品展示柜和露天座位。兔子可以从正门走入，寻找自己的胡萝卜。"}, {"name": "美食街 · 面包店", "position": [-5, -61], "camera": [5, -79, 11], "look": [-5, -61, 1.3], "description": "面包店：彩色遮阳篷、食品展示柜和露天座位。兔子可以从正门走入，寻找自己的胡萝卜。"}, {"name": "美食街 · 星厨精致餐厅", "position": [5, -61], "camera": [15, -79, 11], "look": [5, -61, 1.3], "description": "虚构星厨餐厅，采用精致餐饮氛围，并无真实米其林评级。兔子可以从正门走入，寻找自己的胡萝卜。"}, {"name": "美食街 · 汉堡店", "position": [15, -61], "camera": [25, -79, 11], "look": [15, -61, 1.3], "description": "汉堡店：彩色遮阳篷、食品展示柜和露天座位。兔子可以从正门走入，寻找自己的胡萝卜。"}, {"name": "美食街 · 牛排店", "position": [25, -61], "camera": [35, -79, 11], "look": [25, -61, 1.3], "description": "牛排店：彩色遮阳篷、食品展示柜和露天座位。兔子可以从正门走入，寻找自己的胡萝卜。"}, {"name": "欢乐海岸 · 游乐场", "position": [0, -84], "camera": [44, -111, 30], "look": [0, -83, 2.5], "description": "兔子可以乘摩天轮、旋转木马、玩秋千、滑梯和蹦床。在“兔子游乐设施”中选择项目，兔子会走到入口，游玩后自动下车。"}, {"name": "美食街 · 星巴克咖啡店", "position": [-25, -99], "camera": [-13, -117, 12], "look": [-25, -99, 1.8], "description": "星巴克咖啡店的虚构微缩场景，非真实门店。兔子可以从正门进店寻找胡萝卜。"}, {"name": "美食街 · 麦当劳餐厅", "position": [-13, -99], "camera": [-1, -117, 12], "look": [-13, -99, 1.8], "description": "麦当劳餐厅的虚构微缩场景，非真实门店。兔子可以从正门进店寻找胡萝卜。"}, {"name": "欢乐海岸 · 云霄飞车", "position": [15, -112], "camera": [46, -139, 25], "look": [15, -112, 5], "description": "四节小列车沿起伏双轨循环运行。兔子可走到站外等候，乘坐一圈后回到入口；可用游乐设施按钮同步暂停。"}]}